# =============================================================================
# TERRASYNX Firebase Client Configuration
# Paste your keys directly from Firebase Console:
# Project Overview -> Project Settings -> General -> Your apps -> Web app
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Real Telecom SMS Gateway (Twilio):
# If provided, real SMS OTP will be dispatched to candidate mobile phones via telecom networks.
# If left blank, the app runs in Dev Sandbox Mode with 1-click test OTP verification on-screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Email Gateway credentials for real-world Gmail/Email delivery (e.g., Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# =============================================================================
# JANCH Automated Priority Crawler Secret (Prompt 66)
# Used to authenticate external cron requests to POST /api/janch/run via header:
# x-janch-secret: <JANCH_SECRET>
# =============================================================================
JANCH_SECRET="terrasynx_janch_secret_prod_change_me"

