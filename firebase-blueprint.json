{
  "entities": {
    "sources": {
      "path": "sources/{sourceId}",
      "description": "Verified external publishers, company career portals, government agencies, and hackathon organizers (Prompt 64)",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "officialUrls": { "type": "array" },
        "category": { "type": "string" },
        "country": { "type": "string" },
        "parserType": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "records": {
      "path": "records/{recordId}",
      "description": "Curated programs, hackathons, and opportunities migrated out of code with verified facts, evidence, and status (Prompt 64)",
      "fields": {
        "id": { "type": "string" },
        "sourceId": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "status": { "type": "string" },
        "curatedOn": { "type": "number" },
        "lastVerifiedAt": { "type": "number" },
        "evidence": { "type": "string" },
        "title": { "type": "string" },
        "organizer": { "type": "string" },
        "category": { "type": "string" },
        "country": { "type": "string" },
        "verifiedFacts": { "type": "object" }
      }
    },
    "students": {
      "path": "students/{userId}",
      "description": "Student profile and career fitment data securely owned by student UID",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "degree": { "type": "string" },
        "batch": { "type": "string" },
        "skills": { "type": "array" },
        "projectDescription": { "type": "string" },
        "targetRoles": { "type": "array" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "interviewStories": {
      "path": "students/{userId}/stories/{storyId}",
      "description": "Reusable STAR-format interview stories synthesized from mock interviews and practice sessions",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "roleArchetype": { "type": "string" },
        "roundType": { "type": "string" },
        "questionPrompt": { "type": "string" },
        "starSituation": { "type": "string" },
        "starTask": { "type": "string" },
        "starAction": { "type": "string" },
        "starResult": { "type": "string" },
        "fullNarrative": { "type": "string" },
        "tags": { "type": "array" },
        "targetRoles": { "type": "array" },
        "score": { "type": "number" },
        "grade": { "type": "string" },
        "isStarred": { "type": "boolean" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "studentApplications": {
      "path": "students/{userId}/applications/{applicationId}",
      "description": "Student job applications tracking route provenance (terrasynx_assisted vs direct_official_ats), email identity, and cryptographic confirmation proof",
      "fields": {
        "opportunityId": { "type": "string" },
        "companyName": { "type": "string" },
        "jobTitle": { "type": "string" },
        "companyDomain": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "applicantUid": { "type": "string" },
        "submissionRoute": { "type": "string" },
        "routeLabel": { "type": "string" },
        "appliedTimestamp": { "type": "number" },
        "confirmationId": { "type": "string" },
        "sha256Proof": { "type": "string" },
        "portalType": { "type": "string" },
        "officialApplyUrl": { "type": "string" },
        "currentStage": { "type": "string" },
        "customNotes": { "type": "string" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "hackathonSubmissions": {
      "path": "hackathon_submissions/{submissionId}",
      "description": "User-submitted hackathons queued for live verification and date extraction (Prompt 68)",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "officialUrl": { "type": "string" },
        "organizer": { "type": "string" },
        "submittedAt": { "type": "number" },
        "status": { "type": "string" },
        "submitterEmail": { "type": "string" },
        "verificationResult": { "type": "object" },
        "verifiedHackathon": { "type": "object" }
      }
    }
  }
}
