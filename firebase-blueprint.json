{
  "entities": {
    "students": {
      "path": "students/{userId}",
      "description": "Student profile and career fitment data securely owned by student UID",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "degree": { "type": "string" },
        "batch": { "type": "string" },
        "skills": { "type": "array" },
        "projectDescription": { "type": "string" },
        "targetRoles": { "type": "array" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "interviewStories": {
      "path": "students/{userId}/stories/{storyId}",
      "description": "Reusable STAR-format interview stories synthesized from mock interviews and practice sessions",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "roleArchetype": { "type": "string" },
        "roundType": { "type": "string" },
        "questionPrompt": { "type": "string" },
        "starSituation": { "type": "string" },
        "starTask": { "type": "string" },
        "starAction": { "type": "string" },
        "starResult": { "type": "string" },
        "fullNarrative": { "type": "string" },
        "tags": { "type": "array" },
        "targetRoles": { "type": "array" },
        "score": { "type": "number" },
        "grade": { "type": "string" },
        "isStarred": { "type": "boolean" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "studentApplications": {
      "path": "students/{userId}/applications/{applicationId}",
      "description": "Student job applications tracking route provenance (terrasynx_assisted vs direct_official_ats), email identity, and cryptographic confirmation proof",
      "fields": {
        "opportunityId": { "type": "string" },
        "companyName": { "type": "string" },
        "jobTitle": { "type": "string" },
        "companyDomain": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "applicantUid": { "type": "string" },
        "submissionRoute": { "type": "string" },
        "routeLabel": { "type": "string" },
        "appliedTimestamp": { "type": "number" },
        "confirmationId": { "type": "string" },
        "sha256Proof": { "type": "string" },
        "portalType": { "type": "string" },
        "officialApplyUrl": { "type": "string" },
        "currentStage": { "type": "string" },
        "customNotes": { "type": "string" },
        "updatedAt": { "type": "timestamp" }
      }
    }
  }
}

